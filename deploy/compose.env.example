# Copy to .env on the independent monitoring server and replace the placeholders.
# Use a long random letters-and-digits value; URL-encode special characters if used.
POSTGRES_PASSWORD=replace-with-a-long-random-password
PUBLIC_ORIGIN=https://uptime.example.com
BASE_PATH=
SESSION_COOKIE_SECURE=true
UPTIME_HTTP_PORT=8080

# Optional: both values are required to enable Telegram incident notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
