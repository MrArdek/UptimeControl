# Address used by the HTTP server. Leave empty to use :8080.
HTTP_ADDR=

# PostgreSQL connection URL. Required. Keep the real value only in .env or a secret manager.
DATABASE_URL=

# Browser-facing origin, without a path. Defaults to http://localhost:8080.
PUBLIC_ORIGIN=

# URL path where the application is mounted. Example: /uptimec. Leave empty for root.
BASE_PATH=

# Keep true behind HTTPS. Use false only for local HTTP development.
SESSION_COOKIE_SECURE=true

# Optional Telegram incident notifications. Set both values or leave both empty.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
