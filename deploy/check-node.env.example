CHECK_NODE_BACKEND_URL=https://monitoring.example.com/uptimec
CHECK_NODE_SECRET=replace-with-secret-shown-once
CHECK_NODE_REGION=eu-central
CHECK_NODE_HEALTH_ADDR=127.0.0.1:8090
CHECK_NODE_BUFFER_FILE=/var/lib/uptime-check-node/results.json
CHECK_NODE_POLL_INTERVAL=5s
CHECK_NODE_ALLOW_INSECURE_HTTP=false
